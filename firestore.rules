rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'melissa.sydie@gmail.com' && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Category Validation
    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'order']) && data.keys().size() == 2 &&
             data.name is string && data.name.size() <= 100 &&
             data.order is number;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming()) && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'order']));
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // MenuItem Validation
    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'description', 'price', 'categoryId']) && data.keys().size() == 4 &&
             data.name is string && data.name.size() <= 150 &&
             data.description is string && data.description.size() <= 500 &&
             data.price is string && data.price.size() <= 50 &&
             data.categoryId is string && data.categoryId.size() <= 100;
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(itemId) && isValidMenuItem(incoming());
      allow update: if isAdmin() && isValidId(itemId) && isValidMenuItem(incoming()) && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'categoryId']));
      allow delete: if isAdmin() && isValidId(itemId);
    }

    // DailySpecial Validation
    function isValidDailySpecial(data) {
      return data.keys().hasAll(['dayOfWeek', 'title', 'description', 'price', 'colorTheme']) && data.keys().size() == 5 &&
             data.dayOfWeek is string && data.dayOfWeek.size() <= 20 &&
             data.title is string && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 500 &&
             data.price is string && data.price.size() <= 50 &&
             data.colorTheme is string && data.colorTheme.size() <= 30;
    }

    match /dailySpecials/{specialId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(specialId) && isValidDailySpecial(incoming());
      allow update: if isAdmin() && isValidId(specialId) && isValidDailySpecial(incoming()) && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['dayOfWeek', 'title', 'description', 'price', 'colorTheme']));
      allow delete: if isAdmin() && isValidId(specialId);
    }
  }
}
